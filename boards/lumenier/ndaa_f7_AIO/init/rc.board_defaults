#!/bin/sh
#
# PX4 Lumenier LUX F765 - NDAA specific defaults
#------------------------------------------------------------------------------

# Store missions in RAM
param set-default SYS_DM_BACKEND 1

# Ignore that there is no SD card
param set-default COM_ARM_SDCARD 0

# Don't try to log onto SD card
param set-default SDLOG_MODE -1

param select-backup "/mnt/w25q/parameters_backup.bson"

param set-default BAT1_I_CHANNEL 12
param set-default BAT1_V_CHANNEL 13
param set-default BAT1_V_DIV     11.33

param save
