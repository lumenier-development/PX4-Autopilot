#!/bin/sh
#
# PX4 Lumenier LUX F765 - NDAA specific board sensors init
#------------------------------------------------------------------------------

# Start ADC driver
board_adc start

# Internal SPI bus ICM42688p
icm42688p -R 4 -s start

# Onboard Baro
bmp280 -X start

# External Compass
# qmc5883l -I -R 6 start
lis3mdl -X -q -R 6 start
ist8310 -X -q start
