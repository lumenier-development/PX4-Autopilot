#!/bin/sh
#
# board sensors init
#------------------------------------------------------------------------------

param set-default IMU_GYRO_RATEMAX 1000
param set-default SENS_FLOW_RATE 150
param set-default SENS_IMU_CLPNOTI 0

# AFBR-S50LX85D (50 m, 6 deg): short range mode at 25 Hz up to about 8 m, then
# long range mode at 10 Hz (lower rates give more range). Same values ARK uses
# for this module on the Flow MR.
param set-default SENS_AFBR_S_RATE 25
param set-default SENS_AFBR_L_RATE 10
param set-default SENS_AFBR_THRESH 8
param set-default SENS_AFBR_HYSTER 2

# Internal SPI
paa3905 -s start -Y 0

lsm6dsv -R 0 -s start

afbrs50 start
